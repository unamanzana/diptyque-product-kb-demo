{
  "name": "ai-website-clone-template",
  "version": "0.3.1",
  "private": true,
  "description": "Clone any website into a clean, modern Next.js codebase using AI coding agents",
  "author": "JCodesMore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JCodesMore/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/JCodesMore/ai-website-cloner-template",
  "bugs": {
    "url": "https://github.com/JCodesMore/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "nextjs",
    "ai",
    "template",
    "tailwindcss",
    "shadcn-ui"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run audit:chat-evals && npm run audit:query-plan && npm run audit:conversation-frame && npm run audit:official-copy-rag && npm run audit:queries && npm run audit:catalog && npm run audit:recommendations && npm run lint && npm run typecheck && npm run build",
    "data:rebuild": "python data-pipeline/rebuild.py",
    "data:build-semantic-facts": "python data-pipeline/build_semantic_fact_dataset_v1.py",
    "data:build-frontend-schema-v1-candidate": "python data-pipeline/build_frontend_schema_v1_candidate.py",
    "data:review-relations": "python data-pipeline/review_diptyque_relation_candidates.py",
    "data:adjudicate-relations": "python data-pipeline/adjudicate_diptyque_relation_reviews.py",
    "data:publish-reviewed-relations": "python data-pipeline/adjudicate_diptyque_relation_reviews.py --publish",
    "audit:queries": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-query-catalog.mjs",
    "audit:catalog": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-product-catalog.mjs",
    "audit:recommendations": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-recommendations.mjs",
    "audit:chat-evals": "node scripts/evaluate-diptyque-chat.mjs --validate-only",
    "audit:query-plan": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-query-plan.mjs",
    "audit:official-copy-rag": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-official-copy-rag.mjs",
    "eval:chat": "node scripts/evaluate-diptyque-chat.mjs",
    "audit:conversation-frame": "node --no-warnings --experimental-strip-types scripts/audit-diptyque-conversation-frame.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
